# HTTP server port
PORT=8081

# SQLite database path, relative to the working directory
DATABASE=./data/auth.db

# Session timeouts in seconds.
SESSION_LIFETIME_SECONDS=2592000
SESSION_IDLE_TIMEOUT_SECONDS=604800

# Argon2id cost parameters; memory is in KiB.
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1
# Maximum simultaneous Argon2id operations.
ARGON2_MAX_CONCURRENCY=2
